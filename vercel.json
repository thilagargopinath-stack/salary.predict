{
  "functions": {
    "api/predict.py": {
      "includeFiles": "{simple_linear_regression.csv,frontend/**}"
    }
  },
  "rewrites": [
    {
      "source": "/predict",
      "destination": "/api/predict"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/",
      "destination": "/frontend/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/frontend/$1"
    }
  ]
}
